# ==========================================
# local_graphs - Configuration Environment
# ==========================================

# Server Configuration
PORT=8899
HOST=0.0.0.0
APP_ENV=production

# Storage Directories
DATA_PATH=/data/projects

# Ingestion Settings
MAX_FILE_SIZE_KB=1024
EXCLUDE_DIRS=.git,node_modules,.venv,dist,build,__pycache__,.next,.turbo,.cache,.graphify,cache,log,lib_autogenerated,vendor,storage


